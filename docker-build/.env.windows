# =============================================
# FEP Build Container 設定檔（Windows）
# cp .env.windows.example .env.windows，依需求修改後使用
# =============================================

# [路徑] FEP 原始碼 Git Repo 位置 - host 端
FEP_REPO_PATH=C:\Users\Joe\Repo\idea_clone\mgbfep

# [路徑] FEP 原始碼 Git Repo 位置 - container 內部掛載點（通常不需修改）
REPO_PATH=/workspace/repo

# [路徑] 建置產出物輸出路徑 - host 端（外接硬碟需先掛載，依實際磁碟機代號修改）
HOST_OUTPUT_PATH=D:\mgb-fep-build-output\

# [路徑] 建置產出物輸出路徑 - container 內部掛載點（通常不需修改）
CONTAINER_OUTPUT_PATH=/build/output

# [路徑] Maven 快取（Windows 用 named volume，繞過 WSL2 慢速 bind mount；macOS 用實際路徑）
M2_PATH=fep-m2-cache

# [建置] Branch 名稱
BRANCH=FEP_1-3_SIT

# [建置] 建置模式（擇一填入，空白=完整建置只含 JAR）
#   +web    : 打包全部服務 + WAR（SIT 過版最常用）
#   -Pwar   : 打包 JAR + WAR（fep-war profile）
#   -web    : 只打包 fep-web.war
#   -enclib : 只打包 enclib 模組
#   -safeaa : 只打包 safeaa core
#   (空白)  : 完整建置（只有 JAR，不含 WAR）
BUILD_MODE=+web

# [Git] 是否執行 git pull（true=拉最新/會耗流量，false=用本地現有版本）
GIT_PULL=false

# [Git] 是否執行 git reset --hard（有合併衝突時才改 true）
GIT_RESET=false

# [Native build 選填] 本機 Java 安裝目錄（設定後 run.ps1 可選擇 Native build 跳過 Docker）
# 未設定則依賴系統 PATH
# JAVA_HOME=C:\Program Files\Java\jdk-21

# [Native build 選填] 本機 Maven 安裝目錄（設定後 run.ps1 可選擇 Native build 跳過 Docker）
# 未設定則依賴系統 PATH
MAVEN_HOME=C:\tools\apache-maven-3.9.6
